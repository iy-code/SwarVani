# Copy to backend/.env  (never commit the real file)

# --- demo / safety switches ---------------------------------------------
# true  = no external API calls: deterministic extractor + browser voices
# false = use Gnani streaming speech + configured LLM (needs keys below)
SV_DEMO_MODE=true

# --- storage -------------------------------------------------------------
SV_DB_PATH=.data/swarvani.db
# 32-byte urlsafe base64 Fernet key. Records + transcripts are encrypted at
# rest when this is set. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SV_DB_KEY=

# --- Gnani speech platform ----------------------------------------------
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GNANI_TTS_VOICE=Shivani
GNANI_LANGUAGE=hi-IN

# --- LLM extraction (any OpenAI-compatible provider) ---------------------
LLM_BASE_URL=https://api.qwen.ai/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# --- WhatsApp Business Platform -----------------------------------------
# Webhook verification and signature validation. Outbound sending remains
# disabled until both sending values are configured.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_API_VERSION=v24.0

# --- app ----------------------------------------------------------------
SV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
